{
  "private": true,
  "name": "synonymity",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "redisMemoryServer": {
    "disablePostinstall": true
  },
  "scripts": {
    "build": "vite build",
    "deploy": "bun run type-check && bun run test && bun run build && devvit publish",
    "dev": "devvit playtest",
    "launch": "bun run build && devvit publish",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "login": "devvit login",
    "prettier": "prettier-package-json --write ./package.json && prettier --write .",
    "test": "vitest run",
    "type-check": "tsc --build",
    "word-data:definitions": "bun tools/word-data/build-definitions.ts",
    "word-data:gemini-definitions": "bun tools/word-data/generate-missing-definitions.ts",
    "word-data:embeddings": "bun tools/word-data/embed-definitions.ts",
    "word-data:generate": "bun tools/word-data/generate-word-data.ts",
    "word-data:smoke": "bun tools/word-data/smoke-test.ts",
    "word-data:rebuild": "bun run word-data:definitions && bun run word-data:gemini-definitions && bun run word-data:embeddings && bun run word-data:generate"
  },
  "dependencies": {
    "@devvit/analytics": "0.13.10",
    "@devvit/notifications": "0.13.10",
    "@devvit/shared-types": "0.13.10",
    "@devvit/start": "0.13.10",
    "@devvit/web": "0.13.10",
    "@preact/signals": "^1.2.2",
    "@trpc/client": "11.4.4",
    "@trpc/server": "11.4.4",
    "clsx": "2.1.1",
    "devvit": "0.13.10",
    "express": "4.19.2",
    "posthog-js": "1.268.4",
    "preact": "^10.25.3",
    "superjson": "2.2.2",
    "tailwind-merge": "3.3.0",
    "zod": "4.0.14"
  },
  "devDependencies": {
    "@devvit/test": "0.13.10",
    "@eslint/js": "9.23.0",
    "@preact/preset-vite": "2.10.2",
    "@tailwindcss/vite": "4.1.18",
    "@types/express": "5.0.1",
    "@types/pg": "^8.23.1",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.23.0",
    "globals": "15.15.0",
    "p-queue": "^10.0.0",
    "pg": "^8.23.1",
    "playwright": "1.55.1",
    "prettier": "3.5.3",
    "prettier-package-json": "2.8.0",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "4.1.18",
    "typescript": "5.8.2",
    "typescript-eslint": "8.29.0",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}